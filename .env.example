# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=babycare

# JWT - 반드시 변경 (배포 시 복잡한 랜덤 문자열로)
SECRET_KEY=babycare-secret-key-change-before-deploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760