{
  "expo": {
    "name": "BabyAutoLog",
    "slug": "baby-auto-log",
    "owner": "bambu22",
    "scheme": "babyautolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2D4F"
    },
    "sdkVersion": "54.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.babyautolog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B2D4F"
      }
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "0df2d398-eb87-4a83-9fb6-d25795b257f9"
      }
    }
  }
}
